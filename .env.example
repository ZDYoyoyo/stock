# 複製成 .env 後填入。各段皆為選填。

# FinMind（逐檔深掘/回測用）
#   免費 token：註冊 https://finmindtrade.com/ → 會員中心複製 API Token（填了額度較高）
#   付費 Sponsor：同帳號訂閱後 token 不變，run_mainforce 會自動解鎖「券商分點」
#   詳細步驟見 docs/指令手冊.md「FinMind token 設定」
FINMIND_TOKEN=

# 永豐金 Shioaji（選配升級：盤中即時報價，比免費 TWSE MIS 更快更準）
#   只用「行情」，不碰下單 → 申請時開「正式環境＋行情」即可，不需電子憑證、不需簽下單同意書
#   1) pip install shioaji
#   2) 永豐金證券帳戶 → 申請 API → 取得 API Key 與 Secret Key（詳見 docs/指令手冊.md）
#   填了且裝了套件，src.realtime.quote() 會自動改用 Shioaji；沒填自動退回免費 MIS
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=

# --- 每日報告推播（run_all --notify）---
# 方案A：Telegram（推薦，免費、手機推播）
#   1) 手機 Telegram 搜尋 @BotFather → /newbot → 取得 BOT TOKEN
#   2) 對你的新 bot 傳一則訊息，再開 https://api.telegram.org/bot<TOKEN>/getUpdates
#      找 "chat":{"id":數字} 就是你的 CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 方案B：Email（Gmail 需用「應用程式密碼」，非登入密碼）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=
